From a688dad34cb1b6f51a249155f430580852f1c182 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 03:04:07 +0000
Subject: [PATCH 11/11] Colour a together's cards with their branch

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/lib/auto/components/ui.ts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/lib/auto/components/ui.ts b/src/lib/auto/components/ui.ts
index e3e339e..3caf53c 100644
--- a/src/lib/auto/components/ui.ts
+++ b/src/lib/auto/components/ui.ts
@@ -39,6 +39,9 @@ export function cardColors(cards: AutoCard[]): Map<string, string> {
       if (card.kind === "firstOf") {
         card.rows.forEach((row, index) => walk(row.cards, branchColor(index)));
       }
+      // A together's cards run in the same branch; a goTo's fallback is its own.
+      if (card.kind === "together") walk(card.cards, color);
+      if (card.kind === "goTo") walk(card.ifRefused, "#ff8a3d");
     }
   };
   walk(cards, TRUNK_COLOR);
-- 
