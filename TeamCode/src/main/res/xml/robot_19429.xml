<!--
  Robot configuration for team 19429.

  THIS FILE IS THE SOURCE OF TRUTH FOR THIS ROBOT'S WIRING.

  It ships inside the APK, so it appears in the Driver Station's configuration
  list as "robot_19429" as soon as the app is installed. Nothing is pushed over
  adb and nothing is typed on the Driver Station. Because it is bundled, the DS
  configuration editor shows it read-only - it cannot drift from this file.

  The one manual step that remains: on each robot, select this configuration
  once (DS -> Configure Robot -> Activate). An APK cannot set the active
  configuration; it is a SharedPreferences value on the Robot Controller.

  PORTS ARE A SPECIFICATION, NOT A DESCRIPTION. If the robot is wired
  differently, either rewire to match this file or edit this file to match the
  robot. Either is fine - but one of them has to happen, and this file is the
  side that gets reviewed.

  Device names here must match org.firstinspires.ftc.teamcode.hardware.DeviceNames.
  RobotConfigXmlTest fails the build if they ever disagree.

  Note on I2C: `bus` is the attribute that matters. The SDK reads `bus` and only
  falls back to `port` when `bus` is absent (LynxI2cDeviceConfiguration
  .deserializeAttributes). They are kept equal here so the file cannot be
  misread.

  Note on the Limelight: it is not on a hub. The SDK models it as an
  <EthernetDevice>, a direct child of <Robot> beside the <LynxUsbDevice>, and
  builds the Limelight3A from exactly two attributes (HardwareFactory
  .mapEthernetOverUsb): `name`, and `ipAddress`, which is where the RC sends its
  HTTP requests. 172.29.0.1 is the Limelight 3A's factory address on a
  Linux/Android USB-Ethernet link. If someone gives the camera a static IP in
  its web UI, this attribute must change to match.
  `serialNumber` is only a hardware-map key here; the SDK needs it to start
  with "EthernetOverUsb:" and does not compare it with anything plugged in. It
  repeats the camera's address so the file names one IP, not two.
  Because the device is built from this file, a Limelight that is unplugged
  still appears in the hardware map. The Vision OpModes' "Link" line is what
  says whether it is answering.
-->
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">

            <!-- Drivetrain: mecanum. Layout carried over from the DECODE
                 season's robots, which used these same four ports. -->
            <goBILDA5202SeriesMotor name="frontRight" port="0" />
            <goBILDA5202SeriesMotor name="frontLeft"  port="1" />
            <goBILDA5202SeriesMotor name="backRight"  port="2" />
            <goBILDA5202SeriesMotor name="backLeft"   port="3" />

            <!-- Odometry: goBILDA Pinpoint on I2C bus 1. -->
            <goBILDAPinpoint name="pinpoint" port="1" bus="1" />

            <!-- Transfer colour sensor: a REV Color Sensor V3 on I2C bus 2
                 (bus 0 is the hub's own IMU, 1 the Pinpoint). Data only for now
                 (ColorSensorSubsystem). Added 2 Nov 2026. -->
            <RevColorSensorV3 name="colorSensor" port="2" bus="2" />

            <!-- Intake star wheels: a continuous-rotation servo on servo port 5.
                 One-way clutches let a ball overrun the stars inward; the
                 code runs them while the intake pulls in, backwards while
                 it ejects, and stops them otherwise. Wired 24 Oct 2026. -->
            <ContinuousRotationServo name="intakeStars" port="5" />
            <!-- Mission-critical servos live on this hub, so losing the
                 Expansion Hub does not also take them. PROPOSED PORTS,
                 31 Oct 2026: not yet confirmed with the build team. Rewire to
                 match this file or edit this file to match the robot. -->

            <!-- FLOWER stick: a goBILDA Torque servo swinging the stick, the
                 extractor's first edition (#177). On servo port 0 since
                 6 Nov 2026, the same port as 20245 (it was on port 1, and
                 before that the Expansion Hub's port 1); its measured
                 positions are the servo's, so they carry over. -->
            <Servo name="flowerStick" port="0" />

            <!-- The indicator lights: goBILDA RGB Indicator Lights, more than
                 one, Y-cabled to this one servo port 1, so software sees one
                 device and every light shows the same colour (the servo
                 position). On port 1 since 6 Nov 2026 (it was on 4). This is
                 the one servo wired differently from 20245, whose port 1 is
                 dead and whose lights are on its Expansion Hub. -->
            <Servo name="indicator" port="1" />

            <!-- Transfer: the prefeed wheel (a goBILDA Torque servo in
                 continuous mode) on servo port 2, and the feed gate (a goBILDA
                 Speed servo, positional) on servo port 3. -->
            <ContinuousRotationServo name="prefeed" port="2" />
            <Servo name="feedGate" port="3" />

            <!-- Turret drive: a goBILDA servo in standard (position) mode,
                 programmed with the goBILDA servo programmer, on servo port 4
                 since 6 Nov 2026, as on 20245 (it was on port 0,
                 and before that the Expansion Hub's port 0). It holds a position
                 from PLAY: straight ahead is 0.514 (RobotDifferences). Locked at home
                 (TurretSubsystem.lockedForward) until the turret's encoder is
                 plugged in and checked: see the encoder socket beside motor
                 port 3 below. -->
            <Servo name="turret" port="4" />

        </LynxModule>

        <!-- Expansion Hub: the intake, then the launcher. -->
        <LynxModule name="Expansion Hub" port="2">

            <!-- Intake roller: one goBILDA 5203 motor (#160, #181), on motor
                 port 0, where the build team plugged it in (23 Oct 2026). -->
            <goBILDA5202SeriesMotor name="intake"         port="0" />

            <!-- Launcher: two flywheels and a feeder, the plan agreed with the
                 build team (23 Oct 2026). Not built yet, so nothing is plugged
                 into these; Check: Hardware lists them as missing until it is. -->
            <goBILDA5202SeriesMotor name="launcher_left"  port="1" />
            <goBILDA5202SeriesMotor name="launcher_right" port="2" />
            <goBILDA5202SeriesMotor name="feeder"         port="3" />
            <!-- The ENCODER socket beside motor port 3 is meant for the
                 turret's Studica Cypher Max (quadrature A/B/I, its FTC Control
                 Hub cable; set its switch to 3V3), the build team's choice of
                 24 Oct 2026. The feeder motor's own encoder cable was in it
                 until 6 Nov 2026, when the Cypher Max's replaced it; it counts
                 (counter-clockwise counts down). Code reads
                 the turret angle as the feeder's position
                 (DeviceNames.TURRET_ENCODER_HOST); the feeder never uses its
                 encoder for control. -->

        </LynxModule>
    </LynxUsbDevice>

    <!-- AprilTag camera: Limelight 3A on USB-Ethernet. No hub port. -->
    <EthernetDevice name="limelight" serialNumber="EthernetOverUsb:eth0:172.29.0.1" ipAddress="172.29.0.1" />
</Robot>
